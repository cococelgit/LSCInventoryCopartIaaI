{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Apibara": {
    "BaseUrl": "https://apibara.tech/api/v1/vehicle-auction/",
    "ApiKey": "",
    "PageSize": 20,
    "RequestTimeoutSeconds": 30
