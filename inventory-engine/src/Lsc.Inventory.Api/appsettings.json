{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Apibara": {
    "BaseUrl": "https://apibara.tech/api/v1/vehicle-auction/",
    "ApiKey": "",
    "PageSize": 20,
    "RequestTimeoutSeconds": 30
  },
  "Sync": {
    "Platforms": [ "iaai" ],
    "States": [ "FL" ],
    "IntervalMinutes": 15,
    "PagesPerScope": 1,
    "Enabled": false
  },
  "Persistence": {
    "Provider": "InMemory",
    "PostgreSqlHost": "",
    "Database": "lsc_inventory",
    "ManagedIdentityClientId": "",
    "CommandTimeoutSeconds": 30
  },
  "BlobAudit": {
    "AccountUrl": "",
    "ContainerName": "raw-apibara"
  },
  "CopartExcel": {
    "AccountUrl": "",
    "ContainerName": "copart-raw",
    "SnapshotBlobName": "",
    "MinimumFileSizeKilobytes": 1024,
    "MaximumFileSizeMegabytes": 512,
    "MinimumRowsForCompleteSnapshot": 1000,
    "MinimumRowCountRatioToRecentMedian": 0.70,
    "RecentSnapshotCountForBaseline": 6,
    "ProcessingBatchSize": 1000,
    "AllowInterruptedSnapshotRetry": false,
    "PersistenceConcurrency": 8
  },
  "AllowedHosts": "*"
}
