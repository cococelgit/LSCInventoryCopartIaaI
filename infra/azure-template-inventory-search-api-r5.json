{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "type": "string", "defaultValue": "eastus2" }
  },
  "variables": {
    "identityName": "uai-lsc-inventory-release-afaac3d",
    "identityResourceId": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]",
    "scriptName": "run-inventory-search-api-r5d",
    "scriptUri": "https://lsc-inv-revi-zyn4tlbw.manus.space/manus-storage/federated-deploy-inventory-search-api-r5d_52d5fba4.sh"
  },
  "resources": [
    {
