{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Apibara": {
    "BaseUrl": "https://apibara.tech/api/v1/vehicle-auction/",
    "ApiKey": "",
    "PageSize": 20,
    "RequestTimeoutSeconds": 30,
    "RequestIntervalMilliseconds": 600
  },
  "Sync": {
    "Platforms": [ "iaai" ],
    "States": [ "FL" ],
    "IntervalMinutes": 15,
    "PagesPerScope": 1,
    "Enabled": false
  },
  "IaaINational": {
    "Enabled": false,
    "LotSubStatus": "Open",
    "PagesPerRun": 3,
    "MaxRequestsPerRun": 15,
    "BackfillPagesPerRun": 3200,
    "BackfillMaxRequestsPerRun": 3200,
    "MaintenancePagesPerRun": 3,
    "MaintenanceMaxRequestsPerRun": 15,
    "EnrichVehicleDetails": true,
    "DetailEnrichmentLimitPerRun": 6,
    "BackfillDetailEnrichmentLimitPerRun": 20,
    "MaintenanceDetailEnrichmentLimitPerRun": 6,
    "LeaseMinutes": 240,
    "CaptureUsage": true,
    "MinimumRemainingRequests": 2000,
    "PrimaryProvider": "auctionsapi",
    "FallbackProvider": "apibara",
    "ScheduleTimeZoneId": "America/New_York",
    "ScheduleStartLocalHour": 7,
    "ScheduleEndLocalHour": 23,
    "ScheduleIntervalHours": 2,
    "RequireInitialImportCompleted": true
  },
  "Persistence": {
    "Provider": "InMemory",
    "PostgreSqlHost": "",
    "Database": "lsc_inventory",
    "ManagedIdentityClientId": "",
    "CommandTimeoutSeconds": 30
  },
  "AuctionsApi": {
    "BaseUrl": "https://auctionsapi.com/api/",
    "Enabled": false,
    "AllowWrites": false,
    "ApiKey": "",
    "PageSize": 1000,
    "DefaultOverlapMinutes": 120,
    "RequestTimeoutSeconds": 30,
    "RequestIntervalMilliseconds": 600,
    "InitialImportMaxLots": 100000,
    "InitialImportMaxRequests": 1000
  },
  "FacetsRedis": {
    "Enabled": false,
    "Endpoint": "",
    "ManagedIdentityClientId": "",
    "KeyPrefix": "lsc:facets:v2:",
    "TimeToLiveSeconds": 15,
    "DistributedLockMilliseconds": 4000
  },
  "BlobAudit": {
    "AccountUrl": "",
    "ContainerName": "raw-apibara"
  },
  "CopartExcel": {
    "AccountUrl": "",
    "ContainerName": "copart-raw",
    "SnapshotBlobName": "",
    "MinimumFileSizeKilobytes": 1024,
    "MaximumFileSizeMegabytes": 512,
    "MinimumRowsForCompleteSnapshot": 1000,
    "MinimumRowCountRatioToRecentMedian": 0.70,
    "RecentSnapshotCountForBaseline": 6,
    "ProcessingBatchSize": 1000
  },
  "Scoring": {
    "RunOnStartup": false,
    "BackfillMaximumLots": 500,
    "BatchSize": 100
  },
  "AllowedHosts": "*"
}
